# ── Django ────────────────────────────────────────────────────────────────────
# Chave secreta do Django. Gere com: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=sua-chave-secreta-aqui

# Em desenvolvimento use "True". Sem esta variável o servidor sobe como PRODUÇÃO
# (exige DJANGO_SECRET_KEY e ALLOWED_HOSTS reais, senão nem inicia).
DEBUG=True

# Hosts permitidos separados por vírgula. Em produção é OBRIGATÓRIO e não aceita "*":
# ALLOWED_HOSTS=revisacar-1-qmmv.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Só em produção (opcionais): HSTS em segundos (padrão 30 dias) e redirecionar http→https no Django.
# SECURE_HSTS_SECONDS=2592000
# SECURE_SSL_REDIRECT=False

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sua-anon-ou-service-role-key

# ── Banco de Dados (PostgreSQL via Supabase) ──────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua-senha-do-banco
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
RESET_TOKEN_LIFETIME_SECONDS=900
JWT_ALGORITHM=HS256

# ── Email (para reset de senha e PIN) ────────────────────────────────────────
# Em desenvolvimento (DEBUG=True) o e-mail é impresso no terminal — não precisa de SMTP.
# Em produção use um serviço de e-mail transacional (Brevo, Resend, Amazon SES, Zoho...)
# ou o SMTP do provedor do seu domínio, e configure SPF/DKIM no DNS para não cair no spam.
# (Gmail com senha de app serve só para testes.)
EMAIL_HOST=smtp.seuprovedor.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=usuario-smtp
EMAIL_HOST_PASSWORD=senha-smtp
DEFAULT_FROM_EMAIL=Revisacar <no-reply@seudominio.com.br>

# URL pública do frontend, usada no link do e-mail de redefinição (sem "/" no final).
# OBRIGATÓRIA em produção: sem ela o e-mail de redefinição não é enviado.
FRONTEND_URL=http://localhost:5173
