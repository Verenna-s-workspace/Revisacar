# ── Django ────────────────────────────────────────────────────────────────────
# Chave secreta do Django. Gere com: python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SECRET_KEY=sua-chave-secreta-aqui

# Em desenvolvimento use "True". Sem esta variável o servidor sobe como PRODUÇÃO
# (exige DJANGO_SECRET_KEY e ALLOWED_HOSTS reais, senão nem inicia).
DEBUG=True

# Hosts permitidos separados por vírgula. Em produção é OBRIGATÓRIO e não aceita "*":
# ALLOWED_HOSTS=revisacar-1-qmmv.onrender.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Só em produção (opcionais): HSTS em segundos (padrão 30 dias) e redirecionar http→https no Django.
# SECURE_HSTS_SECONDS=2592000
# SECURE_SSL_REDIRECT=False

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=sua-anon-ou-service-role-key

# ── Banco de Dados (PostgreSQL via Supabase) ──────────────────────────────────
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=sua-senha-do-banco
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=5432

# ── JWT ───────────────────────────────────────────────────────────────────────
ACCESS_TOKEN_LIFETIME_SECONDS=900
REFRESH_TOKEN_LIFETIME_SECONDS=604800
RESET_TOKEN_LIFETIME_SECONDS=900
JWT_ALGORITHM=HS256

# ── Email (para reset de senha e PIN) ────────────────────────────────────────
# Exemplo com Gmail SMTP:
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app
DEFAULT_FROM_EMAIL=noreply@revisacar.com.br

# URL do frontend (usada nos links de redefinição de senha)
FRONTEND_URL=http://localhost:5173
